rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    /*
      DEVELOPMENT ONLY RULES
      ----------------------
      These rules allow local menu image upload testing while Auth/RBAC is
      being stabilized. Restore storage.production.rules before production.
    */
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
