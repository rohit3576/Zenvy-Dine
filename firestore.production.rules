rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isLoggedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTenant(restaurantId) {
      return isLoggedIn() && getUserData().restaurantId == restaurantId;
    }

    function hasRole(role) {
      return isLoggedIn() && getUserData().role == role;
    }

    function isAnyAdmin(restaurantId) {
      return isTenant(restaurantId) && (getUserData().role in ['RESTAURANT_OWNER', 'MANAGER', 'CASHIER', 'KITCHEN_STAFF']);
    }

    function isSuperAdmin() {
      return hasRole('SUPER_ADMIN');
    }

    function restaurantExists(restaurantId) {
      return exists(/databases/$(database)/documents/restaurants/$(restaurantId));
    }

    function isValidPublicOrder() {
      return request.resource.data.restaurantId is string
        && restaurantExists(request.resource.data.restaurantId)
        && request.resource.data.tableNumber is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.status == 'PENDING'
        && request.resource.data.paymentStatus == 'PENDING'
        && request.resource.data.paymentMethod in ['ONLINE', 'CASH'];
    }

    // --- Collections ---

    // Restaurants
    match /restaurants/{restaurantId} {
      allow read: if true; // Public for menu access
      allow create: if isSuperAdmin();
      allow update, delete: if isSuperAdmin() || (isTenant(restaurantId) && hasRole('RESTAURANT_OWNER'));
    }

    // Users
    match /users/{userId} {
      allow read: if isLoggedIn() && (request.auth.uid == userId || isAnyAdmin(getUserData().restaurantId));
      allow create: if isLoggedIn(); // Initial user creation
      allow update: if isLoggedIn() && (request.auth.uid == userId || (isTenant(getUserData().restaurantId) && hasRole('RESTAURANT_OWNER')));
      allow delete: if isSuperAdmin();
    }

    // Menu Categories
    match /menuCategories/{categoryId} {
      allow read: if true;
      allow write: if isTenant(request.resource.data.restaurantId) && (getUserData().role in ['RESTAURANT_OWNER', 'MANAGER']);
      allow update, delete: if isTenant(resource.data.restaurantId) && (getUserData().role in ['RESTAURANT_OWNER', 'MANAGER']);
    }

    // Menu Items
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isTenant(request.resource.data.restaurantId) && (getUserData().role in ['RESTAURANT_OWNER', 'MANAGER']);
      allow update, delete: if isTenant(resource.data.restaurantId) && (getUserData().role in ['RESTAURANT_OWNER', 'MANAGER']);
    }

    // Tables
    match /tables/{tableId} {
      allow read: if true;
      allow write: if isTenant(request.resource.data.restaurantId) && (getUserData().role in ['RESTAURANT_OWNER', 'MANAGER']);
      allow update, delete: if isTenant(resource.data.restaurantId) && (getUserData().role in ['RESTAURANT_OWNER', 'MANAGER']);
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isAnyAdmin(resource.data.restaurantId);
      allow create: if isValidPublicOrder();
      allow update: if isAnyAdmin(resource.data.restaurantId); // Only staff can update status
      allow delete: if isSuperAdmin();
    }

    // Order Items
    match /orderItems/{itemId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAnyAdmin(resource.data.restaurantId);
      allow delete: if isSuperAdmin();
    }

    // Payments (Cloud Functions should handle most, but staff need to read)
    match /payments/{paymentId} {
      allow read: if isAnyAdmin(resource.data.restaurantId);
      allow write: if false; // Only Cloud Functions (Admin SDK) should write payments
    }

    // Waiter Calls
    match /waiterCalls/{callId} {
      allow read, update: if isAnyAdmin(resource.data.restaurantId);
      allow create: if request.resource.data.restaurantId is string
        && restaurantExists(request.resource.data.restaurantId)
        && request.resource.data.tableNumber is string
        && request.resource.data.status == 'OPEN';
      allow delete: if isSuperAdmin();
    }

    // Analytics
    match /analytics/{docId} {
      allow read: if isTenant(resource.data.restaurantId) && hasRole('RESTAURANT_OWNER');
      allow write: if false; // Managed by Cloud Functions
    }
  }
}
