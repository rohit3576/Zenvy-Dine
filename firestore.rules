rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    /*
      DEVELOPMENT ONLY RULES
      ----------------------
      These rules intentionally allow all reads and writes so local development
      can proceed without permission errors while Firebase/Auth/RBAC flows are
      still being stabilized.

      DO NOT DEPLOY THESE RULES TO PRODUCTION.
      Restore firestore.production.rules before production deployment:

        Copy-Item firestore.production.rules firestore.rules
        firebase deploy --only firestore:rules
    */
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
